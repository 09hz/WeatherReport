# Copy to .env and fill in real values. Never commit the populated .env.

FLASK_ENV=development
FLASK_DEBUG=false
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

DATABASE_PATH=instance/weather_journal.db

# External weather lookups stay disabled until BOTH values below are real.
WEATHER_API_KEY=YOUR_WEATHER_API_KEY_HERE
WEATHER_API_BASE_URL=YOUR_WEATHER_PROVIDER_URL_HERE
WEATHER_TIMEOUT_SECONDS=10

# Optional: set to "nws" to use the keyless National Weather Service provider
# for /api/weather/current and snapshots (location given as "lat,lon").
WEATHER_PROVIDER=
# NWS (api.weather.gov) needs no key but requires a descriptive User-Agent
# identifying your app and a contact. Placeholder only - edit in your .env.
NWS_USER_AGENT=YOUR_APP_NAME (YOUR_CONTACT_HERE)
NWS_BASE_URL=https://api.weather.gov
NWS_TIMEOUT_SECONDS=10

SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
