# Copy to .env and fill in real values. Never commit the populated .env.

FLASK_ENV=development
FLASK_DEBUG=false
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

DATABASE_PATH=instance/weather_journal.db

# External weather lookups stay disabled until BOTH values below are real.
WEATHER_API_KEY=YOUR_WEATHER_API_KEY_HERE
WEATHER_API_BASE_URL=YOUR_WEATHER_PROVIDER_URL_HERE
WEATHER_TIMEOUT_SECONDS=10

# Provider response cache. TTL of 0 disables caching entirely.
WEATHER_CACHE_TTL_SECONDS=300
WEATHER_CACHE_MAX_ENTRIES=256

# Request audit trail (JSON Lines). Always disabled under TESTING.
REQUEST_LOG_ENABLED=true
REQUEST_LOG_PATH=.beads/logs/app.log

# Per-client-IP token bucket. Process-local: each worker enforces its own
# bucket, so behind N workers the effective ceiling is N x RATE_LIMIT_REQUESTS.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
