# Copy to .env and fill in real values. Never commit the populated .env.

FLASK_ENV=development
FLASK_DEBUG=false
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

DATABASE_PATH=instance/weather_journal.db
# Optional: a postgres:// URL switches storage to a network database and makes
# DATABASE_PATH unused. Required for durable storage on serverless hosts.
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- Weather provider selection -------------------------------------------
# WEATHER_PROVIDER=nws selects the National Weather Service (api.weather.gov).
# NWS IS KEYLESS: there is no API key to paste anywhere. It only asks for a
# descriptive User-Agent with a real contact so NOAA can reach you if your
# traffic misbehaves. Coverage is the United States only, and lookups are by
# coordinate.
WEATHER_PROVIDER=nws
NWS_USER_AGENT=WeatherReport/0.1 (you@example.com)
NWS_BASE_URL=https://api.weather.gov
NWS_TIMEOUT_SECONDS=10
# Budget for one whole lookup (up to 5 sequential NWS requests).
# 0 means "derive it from NWS_TIMEOUT_SECONDS".
NWS_TOTAL_TIMEOUT_SECONDS=0

# The generic keyed provider, used only when WEATHER_PROVIDER is NOT nws.
# External lookups through it stay disabled until BOTH values below are real.
# Do not put https://api.weather.gov here: that is a base URL, not a key.
WEATHER_API_KEY=YOUR_WEATHER_API_KEY_HERE
WEATHER_API_BASE_URL=YOUR_WEATHER_PROVIDER_URL_HERE
WEATHER_TIMEOUT_SECONDS=10

# Provider response cache. TTL of 0 disables caching entirely.
WEATHER_CACHE_TTL_SECONDS=300
WEATHER_CACHE_MAX_ENTRIES=256

# Request audit trail (JSON Lines). Always disabled under TESTING.
REQUEST_LOG_ENABLED=true
REQUEST_LOG_PATH=.beads/logs/app.log

# Per-client-IP token bucket. Process-local: each worker enforces its own
# bucket, so behind N workers the effective ceiling is N x RATE_LIMIT_REQUESTS.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
