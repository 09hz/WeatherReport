# Copy to .env and fill in real values. Never commit the populated .env.

FLASK_ENV=development
FLASK_DEBUG=false
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

DATABASE_PATH=instance/weather_journal.db

# External weather lookups stay disabled until BOTH values below are real.
WEATHER_API_KEY=YOUR_WEATHER_API_KEY_HERE
WEATHER_API_BASE_URL=YOUR_WEATHER_PROVIDER_URL_HERE
WEATHER_TIMEOUT_SECONDS=10

SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
